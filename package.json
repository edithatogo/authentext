{
  "name": "authentext",
  "version": "3.2.0",
  "description": "Remove signs of AI-generated writing from text.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:distribution": "node scripts/build-distribution-packages.js",
    "evaluate": "node scripts/run-evaluations.js",
    "conductor:reconcile": "node scripts/reconcile-conductor-github.js",
    "sync": "node scripts/compile-skill.js",
    "check:sync": "node scripts/check-sync-clean.js",
    "check:upstream": "node scripts/check-upstream.js",
    "validate": "node scripts/validate-docs.js",
    "validate:hosts": "node scripts/validate-host-overlays.js",
    "validate:conductor": "node scripts/validate-conductor.js",
    "validate:distribution": "node scripts/validate-registry-distribution.js",
    "validate:docs": "node scripts/validate-docs.js",
    "vale": "vale --minAlertLevel=error README.md AGENTS.md docs conductor",
    "check:self-compliance": "node scripts/check-skill-self-compliance.js",
    "lint": "node scripts/lint-markdown.js",
    "lint:js": "eslint . --ext .js,.mjs --ignore-pattern experiments/** --max-warnings=0",
    "format:check": "prettier --check \"README.md\" \"AGENTS.md\" \"package.json\" \"tsconfig.json\" \"src/**/*.{js,json,md,mdx,css,scss,ts,tsx}\" \"scripts/**/*.{js,json,md,mdx,css,scss,ts,tsx}\" \"test/**/*.{js,json,md,mdx,css,scss,ts,tsx}\"",
    "format:fix": "prettier --write \"README.md\" \"AGENTS.md\" \"package.json\" \"tsconfig.json\" \"src/**/*.{js,json,md,mdx,css,scss,ts,tsx}\" \"scripts/**/*.{js,json,md,mdx,css,scss,ts,tsx}\" \"test/**/*.{js,json,md,mdx,css,scss,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "lint:all": "npm run lint && npm run vale && npm run check:self-compliance && npm run lint:js && npm run typecheck && npm run format:check",
    "test": "node scripts/run-node-tests.js && node scripts/run-tests.js",
    "test:coverage": "node scripts/run-coverage.js",
    "build": "node scripts/compile-skill.js",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execSync('npx husky install', { stdio: 'inherit' })\"",
    "release": "echo 'No npm release: Authentext ships Agent Skill artifacts, not a publishable npm library'",
    "version": "npm run sync && git add SKILL.md SKILL_PROFESSIONAL.md references AGENTS.md README.md"
  },
  "lint-staged": {
    "**/*.{js,mjs,ts}": "eslint --fix",
    "**/!(SKILL|SKILL_PROFESSIONAL).md": "markdownlint --fix",
    "AGENTS.md": "prettier --write",
    "README.md": "prettier --write",
    "package.json": "prettier --write",
    "tsconfig.json": "prettier --write",
    "src/**/*.{js,json,md,mdx,css,scss,ts,tsx}": "prettier --write",
    "scripts/**/*.{js,json,md,mdx,css,scss,ts,tsx}": "prettier --write",
    "test/**/*.{js,json,md,mdx,css,scss,ts,tsx}": "prettier --write",
    "conductor/**/*.md": "prettier --write"
  },
  "keywords": [
    "agent-skill",
    "writing",
    "authentext",
    "prompt-engineering",
    "ai-writing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.3",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
