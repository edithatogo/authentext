{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/authentext/blob/main/src/document-intelligence/guidance-source.schema.json",
  "title": "Authentext guidance source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "publisher",
    "url",
    "retrieved_at",
    "source_class",
    "authority",
    "scope",
    "license",
    "status",
    "supported_checks",
    "freshness",
    "drift"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "retrieved_at": { "type": "string", "format": "date" },
    "source_class": {
      "enum": [
        "official-guidance",
        "standards-body",
        "publisher-guidance",
        "government",
        "professional-body",
        "project-local"
      ]
    },
    "authority": {
      "enum": ["user", "project", "binding", "document_type", "domain", "general", "authentext"]
    },
    "scope": { "type": "string", "minLength": 1 },
    "license": { "type": ["string", "null"] },
    "status": { "enum": ["current", "stale", "deferred", "unsupported"] },
    "supported_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_days", "expires_at"],
      "properties": {
        "max_age_days": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "format": "date" }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "checked_at", "previous_hash", "current_hash"],
      "properties": {
        "state": { "enum": ["unknown", "unchanged", "changed"] },
        "checked_at": { "type": ["string", "null"], "format": "date" },
        "previous_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "current_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
